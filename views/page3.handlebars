  <h2>Create a New Dog</h2>
  <form action="/makeDog" method="POST">
    <label for="name">Name:</label>
    <input type="text" name="name" value="">

    <label for="breed">Breed:</label>
    <input type="text" name="breed" value="">

    <label for="age">Age:</label>
    <input type="number" name="age" min="0" value="">

    <input type="submit" value="Create Dog">
  </form>

  <br/>
  <br/>

  <h2>Find Dog by Name and Increase Age</h2>
  <form action="/increaseDogAge" method="POST">
    <label for="name">Dog Name:</label>
    <input type="text" name="name" value="">

    <input type="submit" value="Increase Age">
  </form>
</body>
</html>